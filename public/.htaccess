<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Plain http:// goes to https://. The site answered both, so someone typing
  # the bare address could end up on http:// — unencrypted, and on an origin
  # the API refused.
  #
  # Two conditions, because nginx sits in front of Apache on this host: if it
  # ends TLS itself, Apache sees HTTPS "off" even for a secure visit, and only
  # the forwarded header tells the truth. Checking just one would redirect
  # https to https forever.
  #
  # .well-known is left alone: the certificate renewal reads its challenge
  # there over plain http.
  #
  # 302, not 301, until it has been seen working: a permanent redirect is
  # cached by browsers, and a mistake in it would be too.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=302]

  # Client-side routing. Without this, every URL except the homepage — a
  # shared post, /register, /admin — returns 404 the moment it is refreshed.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Asset filenames carry a hash of their contents, so a given URL never changes
# and the browser may keep it. index.html must NOT be cached, or visitors keep
# loading the old build after every deployment.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|gif|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
